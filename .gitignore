# Release artifacts are built, signed, and uploaded. They never land in git.
*.zip
*.manifest.json
*.manifest.json.sig

# The signing key belongs on the maintainer machine, never here and never in CI.
*.pem
*.key
*.pfx
# Except the public half installs trust, which the release steps verify against.
!/scripts/release-public-key.pem

# The local half of the release pipeline. It reaches for the signing key and for
# an Aegis checkout beside this one, so it is a maintainer-machine tool and not
# part of what this repository publishes.
/scripts/local/

node_modules/

# Socle workspace : present sur disque pour _workspace/tools/scan.py, hors du
# depot public. Meme schema que 4.5-Aegis.clean.
/project.json
/CLAUDE.md
/PRODUCT.md
/VERSION
/.env.example
