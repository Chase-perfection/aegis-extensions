{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Aegis extension catalogue",
  "type": "object",
  "required": [
    "schemaVersion",
    "generatedAt",
    "repo",
    "extensions"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "generatedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "repo": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "extensions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "version",
        "manifestVersion",
        "minAppVersion",
        "labelKey",
        "descKey",
        "icon",
        "page",
        "category",
        "routePrefixes",
        "requiresHostOptIn",
        "file",
        "size",
        "sha256",
        "download",
        "manifest",
        "signature",
        "publishedAt",
        "channel"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "$ref": "#/$defs/semver"
        },
        "manifestVersion": {
          "type": "integer",
          "minimum": 1
        },
        "minAppVersion": {
          "$ref": "#/$defs/semver"
        },
        "labelKey": {
          "type": "string",
          "minLength": 1
        },
        "descKey": {
          "type": "string",
          "minLength": 1
        },
        "icon": {
          "type": "string",
          "minLength": 1
        },
        "page": {
          "type": "string",
          "pattern": "^[^/\\\\]+\\.html$"
        },
        "category": {
          "description": "The store page category rail. Closed list: storeService drops an entry whose category it does not know.",
          "enum": [
            "Detection",
            "Inventory",
            "Compliance",
            "Integrations",
            "Automation"
          ]
        },
        "requiresHostOptIn": {
          "type": "boolean"
        },
        "file": {
          "description": "The package file name, which must equal the `file` field of the signed manifest. extensionInstaller refuses a mismatch, and refuses any name carrying a path separator.",
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$"
        },
        "routePrefixes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^/api/[^/].*[^/]$"
          }
        },
        "size": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "download": {
          "type": "string",
          "format": "uri"
        },
        "manifest": {
          "type": "string",
          "format": "uri"
        },
        "signature": {
          "type": "string",
          "format": "uri"
        },
        "publishedAt": {
          "type": "string",
          "format": "date-time"
        },
        "channel": {
          "enum": [
            "stable",
            "preview"
          ]
        },
        "publisher": {
          "description": "Display string only. It is not evidence: `verified` is established on the Aegis machine, never read from here.",
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "art": {
          "description": "Card artwork on a roughly 100x100 canvas. One shape per object: a path `d` or a circle `c` of [cx, cy, r].",
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "maxProperties": 1,
            "properties": {
              "d": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1200,
                "pattern": "^[Mm][MmZzLlHhVvCcSsQqTtAa0-9,.eE+\\-\\s]*$"
              },
              "c": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number",
                  "minimum": -200,
                  "maximum": 300
                }
              }
            }
          }
        },
        "changelog": {
          "description": "Newest first. Rows without a semver version and non-empty text are dropped by storeService.",
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "version",
              "text"
            ],
            "properties": {
              "version": {
                "$ref": "#/$defs/semver"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 400
              },
              "publishedAt": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      }
    }
  }
}
